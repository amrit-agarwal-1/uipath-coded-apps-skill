# OAuth config for the app (browser PKCE flow)
# Get clientId from UiPath Cloud > Admin > External Applications
VITE_UIPATH_CLIENT_ID=
VITE_UIPATH_SCOPE=OR.Folders OR.Execution OR.Administration Apps.Read Apps.Write DataFabric.Schema.Read DataFabric.Data.Read
VITE_UIPATH_ORG_NAME=
VITE_UIPATH_TENANT_NAME=DefaultTenant
VITE_UIPATH_BASE_URL=https://alpha.api.uipath.com

# CLI deploy credentials (never exposed to the browser — only used by uip codedapp commands)
# Get these from UiPath Cloud > Admin > External Applications (confidential app)
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
# Get from: uip or folders list --output json  (match on Name field, copy Key value)
UIPATH_FOLDER_KEY=
